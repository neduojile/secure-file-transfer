generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  department String?
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  receivedFiles FileTransfer[] @relation("Receiver")
  sentFiles     FileTransfer[] @relation("Sender")
  notifications Notification[]
  securityLogs  SecurityLog[]
}

model FileTransfer {
  id String @id @default(cuid())

  fileName   String
  fileSize   Int
  fileType   String
  storedName String
  filePath   String

  documentType    DocumentType         @default(OTHER)
  department      String?
  confidentiality ConfidentialityLevel @default(CONFIDENTIAL)
  description     String?

  encrypted   Boolean         @default(true)
  hash        String
  currentHash String?
  integrity   IntegrityStatus @default(PENDING)

  downloadCount Int            @default(0)
  status        TransferStatus @default(PENDING)
  senderId      String
  receiverId    String?
  receiverEmail String

  attackAction  AttackAction @default(NONE)
  interceptedAt DateTime?
  verifiedAt    DateTime?

  batchId String?
  iv      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiver     User?         @relation("Receiver", fields: [receiverId], references: [id])
  sender       User          @relation("Sender", fields: [senderId], references: [id])
  securityLogs SecurityLog[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SecurityLog {
  id             String        @id @default(cuid())
  action         String
  attackDetected Boolean       @default(false)
  securityLevel  SecurityLevel
  description    String

  userId     String
  transferId String
  createdAt  DateTime      @default(now())

  transfer FileTransfer @relation(fields: [transferId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  ATTACKER
  LECTURER
  HOD
  EXAM_OFFICER
}

enum DocumentType {
  EXAMINATION
  RESULT
  PROJECT
  ASSIGNMENT
  STUDENT_RECORD
  DEPARTMENTAL
  ADMINISTRATIVE
  RESEARCH
  OTHER
}

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum IntegrityStatus {
  PENDING
  VERIFIED
  COMPROMISED
}

enum AttackAction {
  NONE
  FORWARDED
  MODIFIED
  BLOCKED
}

enum TransferStatus {
  PENDING
  ENCRYPTING
  SENDING
  IN_TRANSIT
  ATTACK_DETECTED
  VERIFYING
  DELIVERED
  REJECTED
}

enum SecurityLevel {
  LOW
  MEDIUM
  HIGH
}